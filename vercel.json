{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/beri/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ],
  "rewrites": [{ "source": "/((?!assets/|beri/|.*\\..*).*)", "destination": "/index.html" }]
}
